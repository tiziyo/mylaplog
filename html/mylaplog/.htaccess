RewriteEngine On

# 0. Redirect root / to /app/
RewriteRule ^$ /app/ [R=301,L]

# 1. API routing: /api/* -> api.php
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ /api.php/$1 [L,QSA]

# 2. If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. SPA Fallback for /app/ subpaths
RewriteRule ^app(/.*)?$ /app/index.html [L]

# 4. SPA Fallback for all other subpaths -> /index.html
RewriteRule ^(.*)$ /index.html [L]

