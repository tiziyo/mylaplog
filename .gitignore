# ==============================================================================
# Git Ignore for Lightsail LAMP Project
# ==============================================================================

# Private Keys & Credentials (CRITICAL SECURITY)
*.pem
*.key
*.ppk
connection_info.txt
credentials.log
application_credentials
lightsail_info.md
.env
.env.*

# Logs and Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/tmp/
/temp/

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# IDE / Editor directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# Local backup files
*.bak
*.bkg
*.swp
*~

# Local scratch and tooling scripts
scratch/

